# SRT Restreamer Environment Configuration
# Copy this file to .env and adjust values.
# NEVER commit the real .env file.

# Security
# Generate a strong random key, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production

# Fernet key for encrypting endpoint secrets (passphrases).
# Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=your-fernet-key-change-in-production

# Public base URL of the UI (scheme://host[:port]). Used for Origin checks.
# Example: APP_BASE_URL=https://restreamer.example.com
APP_BASE_URL=

# Database & Data
DATABASE_URL=sqlite:///data/restreamer.db
DATA_DIR=/app/data

# Server
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8080

# Session cookie: set to false only for local HTTP development.
# In production behind a TLS reverse proxy this must be true.
SESSION_COOKIE_SECURE=true

# Admin bootstrap is performed with:
#   python -m backend.bootstrap_admin
# For one-off automation you may set ADMIN_USERNAME and ADMIN_PASSWORD
# and run the bootstrap command, but do not leave these in .env on a live system.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
